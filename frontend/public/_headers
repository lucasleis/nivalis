/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Hashed assets: JS, CSS, images produced by Vite (filename contains hash)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts served from public/fonts/ (stable filenames, no hash)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Logo used as LCP image (stable filename in public/)
/logo-A6.png
  Cache-Control: public, max-age=31536000, immutable

# Root HTML: never cache, always revalidate
/
  Cache-Control: no-cache, no-store, must-revalidate
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://calendly.com https://*.supabase.co wss://*.supabase.co; frame-src https://calendly.com; worker-src 'none'; object-src 'none'; base-uri 'self'
